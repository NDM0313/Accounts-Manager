# Server / CLI migration credentials — NEVER bundle in Flutter assets.
# Copy to supabase/.env.migrations (gitignored) for tooling only.
#
# Home shared-database applies are NOT done via scripts/apply_migrations.sh.
# Use reviewed files under supabase/reconciliation/home/ with an explicit
# disposable PG17 validation target first.

# FX_MIGRATION_TARGET=legacy_cloud   # required for apply_migrations.sh (legacy only)
# FX_MIGRATION_TARGET=blocked_home_shared_db  # default: refuse home push

SUPABASE_URL=https://api.ndmcore.com
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_database_password_here
# Prefer a session pooler host when applicable:
# SUPABASE_DB_POOLER_HOST=
# SUPABASE_DB_POOLER_PORT=5432

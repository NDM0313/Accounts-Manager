# =============================================================================
# Flutter CLIENT configuration only (public values)
# Copy to: assets/config/client.env
# =============================================================================
# Approved production API: https://api.ndmcore.com
# Studio URLs (db.ndmcore.com / db-stage.*) are REJECTED by the app.
# Legacy Cloud host remains allowlisted only when you set it explicitly here;
# the app never silently falls back to Cloud if this is empty/unreachable.
#
# Do NOT put database passwords, service_role keys, JWT secrets, or tunnel
# tokens in this file. Those belong in supabase/.env.migrations (gitignored).

SUPABASE_URL=https://api.ndmcore.com
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here

# Optional legacy name (prefer SUPABASE_PUBLISHABLE_KEY):
# SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Development-only loopback endpoints (http://127.0.0.1:...) require:
# APP_ENV=development
# FX_ALLOW_DEV_ENDPOINTS=true
